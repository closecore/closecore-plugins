{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "closecore",
  "version": "1.0.0",
  "description": "Analyze and manage the accounting close with CloseCore.",
  "author": {
    "name": "CloseCore",
    "url": "https://www.closecore.com"
  },
  "homepage": "https://www.closecore.com",
  "repository": "https://github.com/closecore/closecore-plugins",
  "keywords": [
    "accounting",
    "close-management",
    "reconciliation"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "CloseCore",
        "shortDescription": "Analyze and manage your accounting close.",
        "longDescription": "Analyze and manage the accounting close with CloseCore.",
        "developerName": "CloseCore",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://www.closecore.com",
        "privacyPolicyURL": "https://www.closecore.com/privacy",
        "termsOfServiceURL": "https://www.closecore.com/terms",
        "brandColor": "#073B33",
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/icon.png",
        "defaultPrompt": [
          "Analyze the current close in CloseCore.",
          "Show me the outstanding close tasks in CloseCore."
        ]
      }
    }
  }
}
